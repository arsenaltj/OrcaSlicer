#!/usr/bin/env bash
set -Eeuo pipefail

employee_id=${1:-}
[[ "$employee_id" =~ ^[1-9][0-9]*$ ]] || exit 64
expected_user=$(printf 's%08d' "$employee_id")
[[ "$(id -un)" == "$expected_user" ]] || exit 77

fail() {
  local stage=$1
  local code=${2:-65}
  local detail=${3:-none}
  logger -t 3dprint-release -- "employee=$employee_id action=${action:-unknown} result=failed stage=$stage detail=$detail"
  printf 'error_stage=%s\ndetail=%s\n' "$stage" "$detail" >&2
  exit "$code"
}

original_command=${SSH_ORIGINAL_COMMAND:-}
[[ "$original_command" != *$'\n'* && "$original_command" != *$'\r'* ]] || fail command 64 newline
read -r -a fields <<<"$original_command"
action=${fields[0]:-}
incoming_dir="/var/lib/3dprint-publishers/$employee_id/incoming"
[[ -d "$incoming_dir" && -O "$incoming_dir" ]] || fail authorization 77 incoming
umask 077

validate_filename() {
  [[ "$filename" =~ ^[0-9A-Za-z._-]+\.exe$ ]] || fail filename 64 invalid
}

validate_release_identity() {
  [[ "$total_size" =~ ^[1-9][0-9]{0,9}$ ]] || fail size 64 invalid_total
  (( total_size <= 1073741824 )) || fail size 64 over_limit
  [[ "$total_sha" =~ ^[0-9a-f]{64}$ ]] || fail sha256 64 invalid_total
  [[ "$source_commit" =~ ^[0-9a-f]{40}$ ]] || fail source 64 invalid
  [[ "$revision" =~ ^[0-9A-Za-z._-]+$ ]] || fail revision 64 invalid
}

lock_release() {
  exec 9>"$incoming_dir/.lock-$filename"
  flock -w 15 9 || fail busy 75 lock_timeout
}

load_metadata() {
  [[ -f "$metadata" && ! -L "$metadata" ]] || fail state 66 missing_metadata
  mapfile -t meta <"$metadata"
  [[ ${#meta[@]} == 6 ]] || fail state 66 invalid_metadata
  meta_size=${meta[0]}
  meta_sha=${meta[1]}
  meta_source=${meta[2]}
  meta_revision=${meta[3]}
  meta_offset=${meta[4]}
  meta_chunk_size=${meta[5]}
  [[ "$meta_size" =~ ^[1-9][0-9]{0,9}$ && "$meta_sha" =~ ^[0-9a-f]{64}$ &&
     "$meta_source" =~ ^[0-9a-f]{40}$ && "$meta_revision" =~ ^[0-9A-Za-z._-]+$ &&
     "$meta_offset" =~ ^[0-9]+$ && "$meta_chunk_size" =~ ^[1-9][0-9]+$ ]] || fail state 66 invalid_metadata
  (( meta_size <= 1073741824 && meta_chunk_size >= 1048576 && meta_chunk_size <= 8388608 &&
     meta_offset <= meta_size )) || fail state 66 invalid_metadata_range
  (( meta_offset == meta_size || meta_offset % meta_chunk_size == 0 )) || fail state 66 invalid_metadata_offset
}

write_metadata() {
  local committed_offset=$1
  local metadata_temp
  metadata_temp=$(mktemp "$incoming_dir/.metadata-XXXXXXXX") || fail state 65 metadata_create
  if ! printf '%s\n%s\n%s\n%s\n%s\n%s\n' "$total_size" "$total_sha" "$source_commit" \
      "$revision" "$committed_offset" "$chunk_limit" >"$metadata_temp"; then
    rm -f -- "$metadata_temp"
    fail state 65 metadata_write
  fi
  if ! mv -f -- "$metadata_temp" "$metadata"; then
    rm -f -- "$metadata_temp"
    fail state 65 metadata_commit
  fi
}

case "$action" in
  status)
    [[ ${#fields[@]} == 2 && "${fields[1]}" == "$employee_id" ]] || fail identity 64 mismatch
    printf 'employee_id=%s\nprotocol=2\npermissions=installer-upload\n' "$employee_id"
    ;;
  begin)
    [[ ${#fields[@]} == 8 && "${fields[1]}" == "$employee_id" ]] || fail identity 64 mismatch
    filename=${fields[2]}
    total_size=${fields[3]}
    total_sha=${fields[4]}
    source_commit=${fields[5]}
    revision=${fields[6]}
    chunk_limit=${fields[7]}
    validate_filename
    validate_release_identity
    [[ "$chunk_limit" =~ ^[1-9][0-9]+$ ]] || fail chunk 64 invalid_limit
    (( chunk_limit >= 1048576 && chunk_limit <= 8388608 )) || fail chunk 64 invalid_limit
    partial="$incoming_dir/$filename.partial"
    metadata="$incoming_dir/$filename.meta"
    lock_release
    if [[ -e "$metadata" ]]; then
      load_metadata
      [[ "$meta_size" == "$total_size" && "$meta_sha" == "$total_sha" &&
         "$meta_source" == "$source_commit" && "$meta_revision" == "$revision" &&
         "$meta_chunk_size" == "$chunk_limit" ]] || fail state 73 identity_conflict
      [[ -f "$partial" && ! -L "$partial" ]] || fail state 66 missing_partial
      actual_size=$(stat -c %s -- "$partial")
      (( actual_size >= meta_offset )) || fail state 66 partial_too_short
      if (( actual_size > meta_offset )); then truncate -s "$meta_offset" -- "$partial"; fi
      offset=$meta_offset
    else
      [[ ! -e "$partial" ]] || fail state 73 orphan_partial
      : >"$partial"
      chmod 0600 "$partial"
      write_metadata 0
      offset=0
    fi
    printf 'employee_id=%s\nprotocol=2\noffset=%s\n' "$employee_id" "$offset"
    ;;
  append)
    [[ ${#fields[@]} == 6 && "${fields[1]}" == "$employee_id" ]] || fail identity 64 mismatch
    filename=${fields[2]}
    requested_offset=${fields[3]}
    chunk_size=${fields[4]}
    chunk_sha=${fields[5]}
    validate_filename
    [[ "$requested_offset" =~ ^[0-9]+$ && "$chunk_size" =~ ^[1-9][0-9]+$ ]] || fail chunk 64 invalid_range
    [[ "$chunk_sha" =~ ^[0-9a-f]{64}$ ]] || fail sha256 64 invalid_chunk
    partial="$incoming_dir/$filename.partial"
    metadata="$incoming_dir/$filename.meta"
    lock_release
    load_metadata
    total_size=$meta_size
    total_sha=$meta_sha
    source_commit=$meta_source
    revision=$meta_revision
    chunk_limit=$meta_chunk_size
    (( chunk_size <= chunk_limit && requested_offset == meta_offset && requested_offset + chunk_size <= total_size )) || fail chunk 65 offset_or_size
    [[ -f "$partial" && ! -L "$partial" ]] || fail state 66 missing_partial
    actual_size=$(stat -c %s -- "$partial")
    (( actual_size >= meta_offset )) || fail state 66 partial_too_short
    if (( actual_size > meta_offset )); then truncate -s "$meta_offset" -- "$partial"; fi
    chunk_file=$(mktemp "$incoming_dir/.chunk-XXXXXXXX")
    trap 'rm -f -- "$chunk_file"' EXIT
    if ! timeout 120 cat >"$chunk_file"; then fail receive 65 interrupted; fi
    actual_chunk_size=$(stat -c %s -- "$chunk_file")
    [[ "$actual_chunk_size" == "$chunk_size" ]] || fail size 65 "expected_${chunk_size}_actual_${actual_chunk_size}"
    actual_chunk_sha=$(sha256sum -- "$chunk_file" | cut -d ' ' -f 1)
    [[ "$actual_chunk_sha" == "$chunk_sha" ]] || fail sha256 65 chunk_mismatch
    cat -- "$chunk_file" >>"$partial" || fail receive 65 append_write
    next_offset=$(( requested_offset + chunk_size ))
    [[ "$(stat -c %s -- "$partial")" == "$next_offset" ]] || fail state 65 append_size
    sync -d "$partial" || fail state 65 sync
    write_metadata "$next_offset"
    rm -f -- "$chunk_file"
    trap - EXIT
    printf 'employee_id=%s\nprotocol=2\noffset=%s\n' "$employee_id" "$next_offset"
    ;;
  commit)
    [[ ${#fields[@]} == 7 && "${fields[1]}" == "$employee_id" ]] || fail identity 64 mismatch
    filename=${fields[2]}
    total_size=${fields[3]}
    total_sha=${fields[4]}
    source_commit=${fields[5]}
    revision=${fields[6]}
    validate_filename
    validate_release_identity
    partial="$incoming_dir/$filename.partial"
    metadata="$incoming_dir/$filename.meta"
    lock_release
    load_metadata
    [[ "$meta_size" == "$total_size" && "$meta_sha" == "$total_sha" &&
       "$meta_source" == "$source_commit" && "$meta_revision" == "$revision" &&
       "$meta_offset" == "$total_size" ]] || fail state 65 incomplete
    [[ -f "$partial" && ! -L "$partial" ]] || fail state 66 missing_partial
    [[ "$(stat -c %s -- "$partial")" == "$total_size" ]] || fail size 65 final_mismatch
    [[ "$(sha256sum -- "$partial" | cut -d ' ' -f 1)" == "$total_sha" ]] || fail sha256 65 final_mismatch
    [[ "$(od -An -tx1 -N2 -- "$partial" | tr -d ' \n')" == '4d5a' ]] || fail mz 65 invalid
    set +e
    promotion_output=$(sudo -n /usr/local/sbin/3dprint-promote-installer \
      "$employee_id" "$partial" "$filename" "$total_size" "$total_sha" "$source_commit" "$revision" 2>&1)
    helper_rc=$?
    set -e
    (( helper_rc == 0 )) || fail promotion 65 "helper_rc_${helper_rc}"
    rm -f -- "$metadata"
    printf '%s\n' "$promotion_output"
    ;;
  *)
    fail protocol 64 unsupported
    ;;
esac
