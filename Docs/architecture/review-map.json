        "preprocessing": "设计预处理",
        "recommending_palette": "推荐配色（源码引用）",
        "awaiting_palette_confirmation": "等待配色确认",
        "awaiting_confirmation": "等待用户确认生成",
        "queued": "排队或恢复任务",
        "running": "生成或下载处理中",
        "ready": "模型结果可用；不等于已导入",
        "stopping": "停止本地任务处理中",
        "stopped": "本地流程已停止；远端可能仍计费",
        "failed": "当前任务失败；需判断恢复方式"
