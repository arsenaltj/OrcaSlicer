              "name": "AwaitingRiskDecision",
              "label": "等待风险处理",
              "type": "waiting"
            },
            {
              "name": "ApplyFailed",
              "label": "应用失败待处理",
              "type": "neutral"
            },
            {
              "name": "Stale",
              "label": "工作区已失效",
              "type": "neutral"
            }
          ]
        },
        {
          "id": "terminal",
          "label": "中断与失败（能否重新开始由条件决定）",
          "states": [
            {
              "name": "Canceling",
