          "type": "waiting",
          "states": [
            "ReadyToApply"
          ],
          "evidence": [
            "slicing_apply"
          ]
        },
        {
          "id": "commit",
          "label": "正式切片完成",
          "detail": "应用、切片、完成",
          "type": "success",
          "states": [
            "Applying",
            "OfficialSlicing",
            "Completed"
          ],
          "evidence": [
            "slicing_apply",
            "slicing_poll"
          ]
        }
      ],
      "state_meanings": {
        "Idle": "可开始",
        "CapturingContext": "采集工作区",
        "Preflighting": "检查可打印性",
        "AwaitingRiskDecision": "存在阻断问题，需处理风险",
        "ReadyForCandidatePlanning": "预检完成，允许规划",
        "PlanningCandidates": "生成候选",
        "TrialSlicingBaseline": "试切基线",
        "TrialSlicingCandidates": "试切候选",
        "ReadyToApply": "比较完成，等待选择或应用",
        "Applying": "应用参数",
        "OfficialSlicing": "正式切片中",
        "Completed": "正式切片完成",
        "ApplyFailed": "应用或正式切片失败",
        "Canceling": "取消处理中",
        "Canceled": "已取消，可重新开始",
        "Stale": "工作区版本失效，需重新采集",
        "Failed": "前置或试切失败"
      },
      "rules": [
        {
          "title": "风险未解决不能规划",
          "detail": "plan_and_slice_candidates 只接受 ReadyForCandidatePlanning；工作区变化会进入 Stale。",
          "evidence": [
            "slicing_start",
            "slicing_plan"
          ]
        },
        {
          "title": "显式选择与应用",
          "detail": "应用需要 ReadyToApply、选中的 Ready 候选和匹配的工作区版本。",
          "evidence": [
            "slicing_apply"
          ]
        },
        {
          "title": "失败或完成后有条件撤销",
          "detail": "仅 ApplyFailed / Completed 且 can_undo_apply 成立时可撤销；成功后回到 ReadyToApply。",
          "evidence": [
            "slicing_undo"
          ]
        },
        {
          "title": "取消和重新开始受状态约束",
          "detail": "can_cancel / can_start 决定可操作状态；不能把应用中当成任意可取消。",
          "evidence": [
            "slicing_states",
            "slicing_cancel"
          ]
        }
      ],
      "state_groups": [
        {
          "id": "waiting",
          "label": "等待与恢复条件（支线状态清单）",
          "states": [
