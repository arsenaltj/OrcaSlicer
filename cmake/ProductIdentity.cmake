# Product branding is independent of the upstream preset/3MF compatibility versions.
set(_product_file "${CMAKE_CURRENT_LIST_DIR}/../config/product.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_product_file}")
file(READ "${_product_file}" _product_json)
string(JSON HONOR_PRODUCT_NAME GET "${_product_json}" display_name)
string(JSON HONOR_PRODUCT_VERSION GET "${_product_json}" version)
string(JSON HONOR_PRODUCT_BUILD GET "${_product_json}" build_number)
string(JSON _build_type TYPE "${_product_json}" build_number)
string(JSON _name_type TYPE "${_product_json}" display_name)
string(JSON _version_type TYPE "${_product_json}" version)
if(NOT _name_type STREQUAL "STRING" OR NOT _version_type STREQUAL "STRING" OR
   NOT HONOR_PRODUCT_NAME MATCHES "^[A-Za-z0-9]+( [A-Za-z0-9]+)*$" OR
   NOT HONOR_PRODUCT_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" OR
   NOT _build_type STREQUAL "NUMBER" OR NOT HONOR_PRODUCT_BUILD MATCHES "^(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Invalid product.json: use a plain product name, major.minor.patch and an integer build_number")
endif()
string(REPLACE "." ";" _product_parts "${HONOR_PRODUCT_VERSION}")
foreach(_part IN LISTS _product_parts HONOR_PRODUCT_BUILD)
    if(_part GREATER 65535)
        message(FATAL_ERROR "product.json version components must be between 0 and 65535")
    endif()
endforeach()
list(GET _product_parts 0 HONOR_VERSION_MAJOR)
list(GET _product_parts 1 HONOR_VERSION_MINOR)
list(GET _product_parts 2 HONOR_VERSION_PATCH)
set(HONOR_PRODUCT_DISPLAY_VERSION "V${HONOR_PRODUCT_VERSION}")
set(HONOR_PRODUCT_FILE_VERSION "${HONOR_PRODUCT_VERSION}.${HONOR_PRODUCT_BUILD}")
string(REPLACE "." "," HONOR_PRODUCT_RESOURCE_VERSION "${HONOR_PRODUCT_FILE_VERSION}")
set(HONOR_PRODUCT_EXE "${HONOR_PRODUCT_NAME}.exe")
set(HONOR_PRODUCT_DLL "${HONOR_PRODUCT_NAME}.dll")
set(HONOR_RESOURCE_FILENAME "${HONOR_PRODUCT_EXE}")
string(REPLACE " " "_" HONOR_PRODUCT_PACKAGE_STEM "${HONOR_PRODUCT_NAME}")
string(TOLOWER "${HONOR_PRODUCT_NAME}" HONOR_PRODUCT_COMMAND)
string(REPLACE " " "-" HONOR_PRODUCT_COMMAND "${HONOR_PRODUCT_COMMAND}")
