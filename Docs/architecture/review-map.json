          "evidence": [
            "generate_confirmation",
            "submit_generation",
            "provider_authorization"
          ]
        },
        {
          "title": "停止不保证远端取消",
          "detail": "停止本地等待与已提交的远端任务计费是两个状态。",
          "evidence": [
            "generate_confirmation",
            "stop_model"
          ]
        },
        {
          "title": "响应中断先恢复原任务",
          "detail": "生成提交响应中断时保留任务编号继续查询，避免为恢复界面重复付费提交。",
          "evidence": [
            "generate_confirmation"
          ]
        },
        {
          "title": "就绪不等于导入完成",
          "detail": "ready 还需产物可用；导入由用户触发。历史保存和恢复具有独立代码入口。",
          "evidence": [
            "import_model",
            "history",
            "restore"
          ]
        }
      ],
      "state_groups": [
        {
          "id": "waiting",
          "label": "等待与异常（支线状态清单）",
          "states": [
