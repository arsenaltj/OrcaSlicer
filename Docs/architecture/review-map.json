          "id": "trial",
          "label": "试切与比较",
          "detail": "基线及候选方案",
          "type": "active",
          "states": [
            "TrialSlicingBaseline",
            "TrialSlicingCandidates"
          ],
          "evidence": [
            "slicing_plan"
          ]
        },
        {
          "id": "decision",
          "label": "等待用户应用",
