#!/usr/bin/env bash
set -Eeuo pipefail

[[ "$(id -u)" == 0 ]] || { echo 'Run as root.' >&2; exit 77; }
[[ $# == 1 ]] || { echo 'Usage: install-restricted-publisher EMPLOYEE_ID < public-key.pub' >&2; exit 64; }
employee_id=$1
[[ "$employee_id" =~ ^[1-9][0-9]*$ ]] || { echo 'Employee ID must be canonical digits.' >&2; exit 64; }
account=$(printf 's%08d' "$employee_id")
IFS= read -r public_key
public_key=${public_key%$'\r'}
[[ "$public_key" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+={0,3}(\ [A-Za-z0-9@._+-]+)?$ ]] || {
  echo 'Only one OpenSSH ED25519 public key line is accepted.' >&2
  exit 65
}
fingerprint=$(printf '%s\n' "$public_key" | ssh-keygen -lf - -E sha256 | awk '{print $2}')
[[ "$fingerprint" == SHA256:* ]] || { echo 'Unable to validate public-key fingerprint.' >&2; exit 65; }

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
install -o root -g root -m 0755 "$script_dir/3dprint-release-dispatch" /usr/local/libexec/3dprint-release-dispatch
install -o root -g root -m 0755 "$script_dir/3dprint-promote-installer" /usr/local/sbin/3dprint-promote-installer

publisher_root="/var/lib/3dprint-publishers/$employee_id"
install -d -o root -g root -m 0755 /var/lib/3dprint-publishers
if ! getent passwd "$account" >/dev/null; then
  useradd --home-dir "$publisher_root" --create-home --shell /bin/bash \
    --comment "Restricted release publisher $employee_id" "$account"
fi
usermod --lock "$account"
install -d -o "$account" -g "$account" -m 0700 "$publisher_root" "$publisher_root/incoming"
install -d -o "$account" -g "$account" -m 0700 "$publisher_root/.ssh"
authorized_keys=$(mktemp)
trap 'rm -f -- "$authorized_keys"' EXIT
printf 'restrict,command="/usr/local/libexec/3dprint-release-dispatch %s" %s\n' "$employee_id" "$public_key" >"$authorized_keys"
install -o "$account" -g "$account" -m 0600 "$authorized_keys" "$publisher_root/.ssh/authorized_keys"

sudoers_tmp=$(mktemp)
trap 'rm -f -- "$authorized_keys" "$sudoers_tmp"' EXIT
printf '%s ALL=(root) NOPASSWD: /usr/local/sbin/3dprint-promote-installer\n' "$account" >"$sudoers_tmp"
visudo -cf "$sudoers_tmp" >/dev/null
install -o root -g root -m 0440 "$sudoers_tmp" "/etc/sudoers.d/3dprint-release-$account"

if [[ -f /home/web/bin/deploy-3dprint-beer ]]; then
  chown web:web /home/web/bin/deploy-3dprint-beer
  chmod 0750 /home/web/bin/deploy-3dprint-beer
fi
sshd -t
logger -t 3dprint-release -- "employee=$employee_id action=publisher-enrolled fingerprint=$fingerprint"
printf 'employee_id=%s\naccount=%s\nfingerprint=%s\npermissions=installer-upload\n' \
  "$employee_id" "$account" "$fingerprint"
