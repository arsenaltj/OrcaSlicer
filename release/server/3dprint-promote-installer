#!/usr/bin/env bash
set -Eeuo pipefail

[[ "$(id -u)" == 0 ]] || exit 77
[[ $# == 7 ]] || exit 64
employee_id=$1
source_path=$2
filename=$3
size_bytes=$4
sha256=$5
source_commit=$6
revision=$7

[[ "$employee_id" =~ ^[1-9][0-9]*$ ]] || exit 64
expected_user=$(printf 's%08d' "$employee_id")
[[ "${SUDO_USER:-}" == "$expected_user" ]] || exit 77
[[ "$filename" =~ ^[0-9A-Za-z._-]+\.exe$ ]] || exit 64
[[ "$size_bytes" =~ ^[1-9][0-9]{0,9}$ ]] || exit 64
(( size_bytes <= 1073741824 )) || exit 64
[[ "$sha256" =~ ^[0-9a-f]{64}$ ]] || exit 64
[[ "$source_commit" =~ ^[0-9a-f]{40}$ ]] || exit 64
[[ "$revision" =~ ^[0-9A-Za-z._-]+$ ]] || exit 64

incoming_root="/var/lib/3dprint-publishers/$employee_id/incoming"
resolved_source=$(realpath -e -- "$source_path")
[[ "$resolved_source" == "$incoming_root/"* ]] || exit 77
[[ -f "$resolved_source" && ! -L "$resolved_source" ]] || exit 65
[[ "$(stat -c %U -- "$resolved_source")" == "$expected_user" ]] || exit 77
[[ "$(stat -c %h -- "$resolved_source")" == 1 ]] || exit 65
[[ "$(stat -c %s -- "$resolved_source")" == "$size_bytes" ]] || exit 65
[[ "$(sha256sum -- "$resolved_source" | cut -d ' ' -f 1)" == "$sha256" ]] || exit 65
[[ "$(od -An -tx1 -N2 -- "$resolved_source" | tr -d ' \n')" == '4d5a' ]] || exit 65

download_dir=/srv/3dprint-beer/data/downloads
[[ -d "$download_dir" ]] || exit 66
destination="$download_dir/$filename"
if [[ -e "$destination" ]]; then
  [[ -f "$destination" && ! -L "$destination" ]] || exit 73
  [[ "$(stat -c %s -- "$destination")" == "$size_bytes" ]] || exit 73
  [[ "$(sha256sum -- "$destination" | cut -d ' ' -f 1)" == "$sha256" ]] || exit 73
  chown web:web "$destination"
  chmod 0644 "$destination"
else
  staging=$(mktemp "$download_dir/.publish-XXXXXXXX")
  trap 'rm -f -- "$staging"' EXIT
  install -o web -g web -m 0644 -- "$resolved_source" "$staging"
  [[ "$(sha256sum -- "$staging" | cut -d ' ' -f 1)" == "$sha256" ]] || exit 65
  ln -- "$staging" "$destination"
  rm -f -- "$staging"
  trap - EXIT
fi

rm -f -- "$resolved_source"
logger -t 3dprint-release -- "employee=$employee_id action=installer-upload filename=$filename size=$size_bytes sha256=$sha256 source=$source_commit revision=$revision"
printf 'uploaded=true\nemployee_id=%s\nfilename=%s\nsize_bytes=%s\nsha256=%s\nsource_commit=%s\nrevision=%s\n' \
  "$employee_id" "$filename" "$size_bytes" "$sha256" "$source_commit" "$revision"
